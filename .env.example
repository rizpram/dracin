APP_PORT=8080
CAPTAIN_API_URL=https://captain.sapimu.au
CAPTAIN_API_TOKEN=replace-with-a-rotated-token
CAPTAIN_TIMEOUT_MS=20000
SANSEKAI_API_URL=https://api.sansekai.my.id

# API saving mode
DRACIN_CACHE_FEED_SECONDS=900
DRACIN_CACHE_SEARCH_SECONDS=600
DRACIN_CACHE_DETAIL_SECONDS=1800
DRACIN_CACHE_EPISODES_SECONDS=3600
DRACIN_CACHE_STREAM_SECONDS=180
DRACIN_CACHE_STALE_SECONDS=21600

# Monetization
# Public AdSense publisher/client identifier used by the Google loader.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-9886009042389859
# Add the ad unit slot IDs created in AdSense when available.
NEXT_PUBLIC_ADSENSE_HOME_SLOT=
NEXT_PUBLIC_ADSENSE_DETAIL_SLOT=
# Keep the real Saweria widget URL only in deployment environment variables, not in the public repository.
NEXT_PUBLIC_SAWERIA_QR_URL=
NEXT_PUBLIC_SAWERIA_URL=
