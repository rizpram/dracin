APP_PORT=8080
CAPTAIN_API_URL=https://captain.sapimu.au
CAPTAIN_API_TOKEN=replace-with-a-rotated-token
CAPTAIN_TIMEOUT_MS=20000
SANSEKAI_API_URL=https://api.sansekai.my.id

# API saving mode
# Feed/home/rank/recommendation: 15 minutes
DRACIN_CACHE_FEED_SECONDS=900
# Search: 10 minutes
DRACIN_CACHE_SEARCH_SECONDS=600
# Drama/detail metadata: 30 minutes
DRACIN_CACHE_DETAIL_SECONDS=1800
# Episode lists: 60 minutes
DRACIN_CACHE_EPISODES_SECONDS=3600
# Stream/play URLs: short TTL because signed URLs may expire
DRACIN_CACHE_STREAM_SECONDS=180
# Serve stale cached data for up to 6 hours when upstream is temporarily unavailable
DRACIN_CACHE_STALE_SECONDS=21600
